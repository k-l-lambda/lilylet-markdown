{
  "name": "@k-l-lambda/lilylet-markdown",
  "version": "0.1.61",
  "description": "Markdown-it plugin for rendering Lilylet music notation",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc --emitDeclarationOnly && node scripts/build.mjs",
    "test": "npm run build && node --test tests/entrypoints.test.mjs && npm run test:types",
    "test:demo": "node tests/test.js",
    "prepack": "npm run build",
    "test:types": "tsc --noEmit --strict --module NodeNext --moduleResolution NodeNext --target ES2022 tests/types/require.cts tests/types/import.mts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k-l-lambda/lilylet-markdown.git"
  },
  "keywords": [
    "markdown-it",
    "markdown",
    "music",
    "notation",
    "lilylet",
    "lilypond",
    "sheet-music"
  ],
  "author": "k.l.lambda",
  "license": "ISC",
  "dependencies": {
    "verovio": "^4.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^20.11.0",
    "markdown-it": "^14.0.0",
    "typescript": "^5.3.0",
    "@k-l-lambda/lilylet": "0.1.90",
    "esbuild": "0.21.5"
  },
  "peerDependencies": {
    "markdown-it": ">=12.0.0"
  },
  "module": "lib/index.js"
}
